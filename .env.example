# Google Sheets API
GOOGLE_SERVICE_ACCOUNT_JSON=credentials/service_account.json
LEADS_SPREADSHEET_ID=your_spreadsheet_id_here

# Apollo.io (lead enrichment)
APOLLO_API_KEY=your_apollo_key_here

# Hunter.io (email finding)
HUNTER_API_KEY=your_hunter_key_here

# LinkedIn / Phantombuster (optional scraping)
PHANTOMBUSTER_API_KEY=your_phantombuster_key_here

# OpenAI (optional: AI-powered scoring/summarisation)
OPENAI_API_KEY=your_openai_key_here

# Slack (optional: notifications)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# General
LOG_LEVEL=INFO
DRY_RUN=false

# Seal Phase-Shift Scraper
# Comma-separated source URLs. You can also pass --url or --source-file at runtime.
PHASE_SHIFT_SOURCE_URLS=
